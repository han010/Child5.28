# 地图配置文件示例
# 这是 slam_toolbox 生成的地图配置文件格式

# 地图图像文件 (pgm 格式)
image: map.pgm

# 地图分辨率 (米/像素)
resolution: 0.05

# 地图原点在图像中的位置 (像素)
# 原点通常是地图左下角
origin: [-10.0, -10.0, 0.0]

# 占用概率阈值
# 像素值 > occupied_thresh 的区域被认为是障碍物
occupied_thresh: 0.65

# 空闲概率阈值
# 像素值 < free_thresh 的区域被认为是可通行区域
free_thresh: 0.25

# 地图模式: trinary (三值), scale (缩放), raw (原始)
# trinary: 强制将像素映射为 0(空闲), 100(占用), 255(未知)
mode: trinary

# 取反图像 (如果地图是黑色背景白色障碍物，设为 true)
negate: 0
