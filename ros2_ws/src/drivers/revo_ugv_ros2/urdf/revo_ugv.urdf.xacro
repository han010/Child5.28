<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="revo_ugv">
  <xacro:property name="PI" value="3.141592653589793"/>
  <!-- Basic geometry properties (meters) -->
  <xacro:property name="chassis_length" value="1.33"/>
  <xacro:property name="chassis_width" value="0.47"/>
  <xacro:property name="chassis_height" value="0.05"/>

  <xacro:property name="wheel_radius" value="0.2"/>
  <xacro:property name="wheel_width" value="0.1"/>
  <xacro:property name="wheel_base" value="0.65"/>
  <xacro:property name="wheel_track" value="0.705"/>
  <xacro:property name="wheel_center_z" value="-0.2"/>

  <xacro:property name="base_to_ground" value="${-(wheel_center_z - wheel_radius)}"/>
  <xacro:property name="collision_padding" value="0.1"/>
  <xacro:property name="collision_size_x" value="${chassis_length + collision_padding}"/>
  <xacro:property name="collision_size_y" value="${wheel_track + wheel_width + collision_padding}"/>
  <xacro:property name="collision_size_z" value="${base_to_ground + lidar_mount_z + collision_padding}"/>
  <xacro:property name="collision_origin_z" value="${-base_to_ground + collision_size_z * 0.5}"/>
  
  <!-- Camera properties (meters) -->
  <xacro:property name="camera_size_x" value="0.05"/>
  <xacro:property name="camera_size_y" value="0.08"/>
  <xacro:property name="camera_size_z" value="0.04"/>
  <xacro:property name="camera_mount_x" value="0.4"/>
  <xacro:property name="camera_mount_z" value="0.3"/>

  <!-- LiDAR properties (meters) -->
  <xacro:property name="lidar_radius" value="0.05"/>
  <xacro:property name="lidar_height" value="0.1"/>
  <xacro:property name="lidar_mount_z" value="0.6"/>

  <!-- Mass/inertia placeholders to keep robot_state_publisher happy -->
  <xacro:macro name="default_inertial" params="mass ixx iyy izz ixy iyz ixz">
    <inertial>
      <mass value="${mass}"/>
      <inertia ixx="${ixx}" ixy="${ixy}" ixz="${ixz}" iyy="${iyy}" iyz="${iyz}" izz="${izz}"/>
    </inertial>
  </xacro:macro>

  <!-- Virtual link aligned to ground (wheel contact plane) -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius * 2.0}" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.2 0.2 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${collision_origin_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${collision_size_x} ${collision_size_y} ${collision_size_z}"/>
      </geometry>
    </collision>
    <xacro:default_inertial mass="40.0" ixx="1.0" iyy="1.0" izz="1.0" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </link>

  <!-- Wheel macro -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="black">
          <color rgba="0.05 0.05 0.05 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:default_inertial mass="5.0" ixx="0.1" iyy="0.1" izz="0.1" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${wheel_center_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Camera macro -->
  <xacro:macro name="camera" params="name parent *origin">
    <link name="${name}">
      <visual>
        <!-- Visual origin: center of the box (offset is handled in joint) -->
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${camera_size_x} ${camera_size_y} ${camera_size_z}"/>
        </geometry>
        <material name="camera_gray">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <xacro:default_inertial mass="0.2" ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <xacro:insert_block name="origin"/>
    </joint>
  </xacro:macro>

  <!-- LiDAR macro -->
  <xacro:macro name="lidar" params="name parent *origin">
    <link name="${name}">
      <visual>
        <!-- Visual origin at cylinder bottom, so offset z by lidar_height/2 -->
        <origin xyz="0 0 ${lidar_height / 2.0}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
        </geometry>
        <material name="lidar_orange">
          <color rgba="1.0 0.5 0.0 1.0"/>
        </material>
      </visual>
      <xacro:default_inertial mass="0.5" ixx="0.01" iyy="0.01" izz="0.01" ixy="0.0" iyz="0.0" ixz="0.0"/>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <xacro:insert_block name="origin"/>
    </joint>
  </xacro:macro>

  <!-- Wheel positions: wheelbase 0.65 m, track (centerline) 0.705 m -->
  <xacro:property name="wheel_offset_x" value="${wheel_base * 0.5}"/>
  <xacro:property name="wheel_offset_y" value="${wheel_track * 0.5}"/>

  <xacro:wheel name="front_left_wheel" x="${wheel_offset_x}" y="${wheel_offset_y}"/>
  <xacro:wheel name="front_right_wheel" x="${wheel_offset_x}" y="-${wheel_offset_y}"/>
  <xacro:wheel name="rear_left_wheel" x="-${wheel_offset_x}" y="${wheel_offset_y}"/>
  <xacro:wheel name="rear_right_wheel" x="-${wheel_offset_x}" y="-${wheel_offset_y}"/>

  <!-- Sensors -->
  <!-- Camera: front-left position (x=0.4, y=0.2, top at z=0.18) -->
  <!-- Box center z = 0.18 - camera_size_z/2 = 0.18 - 0.02 = 0.16 -->
  <xacro:camera name="camera" parent="base_link">
    <origin xyz="0.4 0.2 0.16" rpy="0 0 0"/>
  </xacro:camera>

  <!-- LiDAR: front-center position (x=0.4, y=0, bottom at z=0.2) -->
  <xacro:lidar name="lidar" parent="base_link">
    <origin xyz="0.4 0 0.2" rpy="0 0 0"/>
  </xacro:lidar>

  <!-- ros2_control: generic system placeholder. Replace plugin with a hardware interface that talks to Revo SDK if desired. -->
  <ros2_control name="revo_ugv_control" type="system">
    <hardware>
      <!-- 使用 fake_components/GenericSystem 以便在无硬件接口时仍可加载控制器 -->
      <plugin>fake_components/GenericSystem</plugin>
      <param name="command_interfaces">["velocity"]</param>
      <param name="state_interfaces">["position", "velocity"]</param>
    </hardware>
    <joint name="front_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Transmissions to satisfy diff_drive_controller -->
  <transmission name="front_left_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_left_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_left_wheel_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="front_right_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="front_right_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="front_right_wheel_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="rear_left_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_left_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="rear_left_wheel_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="rear_right_wheel_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rear_right_wheel_joint">
      <hardwareInterface>hardware_interface/VelocityJointInterface</hardwareInterface>
    </joint>
    <actuator name="rear_right_wheel_motor">
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
</robot>
